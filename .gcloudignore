# Manabi Kōbō — Google Cloud Build source exclusions
.gcloudignore
.git
.gitignore
.github/
.idea/
.vscode/
.venv/
venv/
__pycache__/
**/__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.py[cod]
*.zip
*.log
.env
.env.*
!.env.example
.DS_Store

# Tutorial guide assets are production runtime files. Keep these explicitly included
# even if broader static-asset exclusions are introduced later.
!app/static/css/how-to-use.css
!app/static/assets/tutorial/
!app/static/assets/tutorial/**
